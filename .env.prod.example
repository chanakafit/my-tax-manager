# Database credentials (used by both MariaDB container init and PHP app)
MYSQL_ROOT_PASSWORD=change_this_root_password
MYSQL_DATABASE=mybs
MYSQL_USER=mybs_user
MYSQL_PASSWORD=change_this_password
DB_PREFIX=mb_

# phpMyAdmin
PMA_PASSWORD=change_this_root_password

# Application
APP_NAME=Finance Manager
COOKIE_VALIDATION_KEY=generate_a_random_32_char_string_here

# Mail — SMTP DSN format: smtp://user:password@host:port
# Mailjet:  smtp://<API_KEY>:<SECRET_KEY>@in-v3.mailjet.com:2525
#           (the sender address must be a validated sender in the Mailjet account)
# Port 2525, not 587: the droplet's provider blocks outbound 25, 465 and 587,
# so any relay has to be reached on an alternative port.
# Use null://null to disable mail
# A change here only takes effect once the php container is recreated:
#   docker compose -f docker-compose.prod.yml up -d php
MAIL_DSN=smtp://user:password@smtp.host:587
