# Local dev config — copy to .env.local (git-ignored):  cp .env.local.example .env.local

# --- Host ports (bound to 127.0.0.1 only) ---
# app         -> http://fin.localhost:${HTTP_PORT}   (also http://localhost:${HTTP_PORT})
# phpMyAdmin  -> http://localhost:${PMA_PORT}
# MariaDB     -> 127.0.0.1:${DB_PORT}   (root / root)
HTTP_PORT=8090
PMA_PORT=8091
DB_PORT=3307

# --- Application ---
APP_ENV=dev
YII_DEBUG=true
CONSTRUCTION_MODE=0
APP_NAME=Fin (local)
COOKIE_VALIDATION_KEY=local-dev-only-not-a-secret-0123456789
SESSION_NAME=fin-local
# null://null discards mail. Real SMTP: smtp://user:pass@host:587
MAIL_DSN=null://null

# --- Database ---
# Container-internal connection (php -> mariadb). Host tools use 127.0.0.1:DB_PORT.
MYSQL_HOST=mariadb
MYSQL_DATABASE=mybs
MYSQL_PASSWORD=root
MYSQL_ROOT_PASSWORD=root
DB_PREFIX=mb_

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# --- Default admin (created during migrate/up) ---
ADMIN_DEFAULT_USER=admin
ADMIN_DEFAULT_EMAIL=admin@fin.local
ADMIN_DEFAULT_PASSWORD=admin123
